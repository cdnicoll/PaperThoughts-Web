rules_version = '2';

// Deny everything by default. The feedback collection's create-only rules
// land with the feedback-form work (web issue #4) — until then nothing in
// Firestore is client-reachable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
